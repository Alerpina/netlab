# Copie para .env (o .env fica fora do Git) e preencha.
# Grafana Cloud > sua stack > OpenTelemetry > Configure: endpoint, Instance ID e um token
# com escopo de escrita (metrics:write, traces:write, logs:write).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=

# Senha dos SR Linux (padrão do containerlab)
SRL_PASSWORD=NokiaSrl1!
